# App-level defaults used by the dashboard backend and summarizer worker.
# Do not commit real secrets.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Default email provider settings used as a fallback.
# Per-user/provider defaults can override these.
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_FOLDER=INBOX
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Optional app-wide sender defaults
SMTP_USER=
SMTP_PASSWORD=
SUMMARY_RECIPIENT=

# Hosted storage locations
EMAIL_SUMMARIZER_STORAGE_DIR=/var/app/data
EMAIL_SUMMARIZER_OUTPUT_DIR=/var/app/output
EMAIL_SUMMARIZER_BACKUP_DIR=/var/app/backups
EMAIL_SUMMARIZER_PUBLIC_BASE_URL=https://your-domain.example.com
EMAIL_SUMMARIZER_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://your-domain.example.com
EMAIL_SUMMARIZER_COOKIE_SECURE=true
EMAIL_SUMMARIZER_COOKIE_DOMAIN=
EMAIL_SUMMARIZER_ENCRYPTION_KEY=
EMAIL_SUMMARIZER_RATE_LIMIT_ENABLED=true
EMAIL_SUMMARIZER_MONITORING_ENABLED=true
EMAIL_SUMMARIZER_MAX_REQUEST_BODY_BYTES=1048576
EMAIL_SUMMARIZER_SAVE_RAW_DEBUG=false
EMAIL_SUMMARIZER_INCLUDE_ATTACHMENT_PREVIEWS_IN_LLM=false
EMAIL_SUMMARIZER_RAW_EMAIL_RETENTION_DAYS=7
EMAIL_SUMMARIZER_ATTACHMENT_RETENTION_DAYS=30
EMAIL_SUMMARIZER_SOURCE_EMAIL_RETENTION_DAYS=0

# Optional Google OAuth for hosted sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.example.com/auth/google/callback

# Optional Microsoft OAuth for Outlook/Hotmail/Microsoft 365 sign-in
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=https://your-domain.example.com/auth/microsoft/callback
